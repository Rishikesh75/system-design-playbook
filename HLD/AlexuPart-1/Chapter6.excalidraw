        }
      ],
      "updated": 1787512496984,
      "link": null,
      "locked": false,
      "text": "Single Server KV Store\n\n\nSimple: hashmap in memory\nProblem: doesn't fit in memory\nFixes: compression, store only frequently used data in RAM, rest on disk\n\n\n\"single server isn't enough\" → leads into distributed store",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Single Server KV Store\n\n\nSimple: hashmap in memory\nProblem: doesn't fit in memory\nFixes: compression, store only frequently used data in RAM, rest on disk\n\n\n\"single server isn't enough\" → leads into distributed store",
      "autoResize": true,
      "lineHeight": 1.25
    },
