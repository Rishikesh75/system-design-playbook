      "updated": 1787510968927,
      "link": null,
      "locked": false,
      "text": "Distributed KV Store Fundamentals\n\nCAP Theorem :\nCP: consistency + partition tolerance (sacrifice availability)\nAP: availability + partition tolerance (sacrifice consistency)\nCA: not realistic in distributed systems (network partitions always possible)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Distributed KV Store Fundamentals\n\nCAP Theorem :\nCP: consistency + partition tolerance (sacrifice availability)\nAP: availability + partition tolerance (sacrifice consistency)\nCA: not realistic in distributed systems (network partitions always possible)",
      "autoResize": true,
      "lineHeight": 1.25
    },
