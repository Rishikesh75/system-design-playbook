    {
      "id": "U_kyG2WuYchDA-k9M5Qxt",
      "type": "text",
      "x": 337.8859199426662,
      "y": 644.9862339070635,
      "width": 647.3595581054688,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yAV_TQIfb442GAKfNvo7b"
      ],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 939033734,
      "version": 265,
      "versionNonce": 866772826,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790069200695,
      "link": null,
      "locked": false,
      "text": "User get 10GB free space\nAssume user uploads 2 files perday the average file size is 500KB\n1:1 read to write ratio\n50Million * 10GB = 500PB\n10 Million * 2 / 24 / 3600 = 240\npeak qps = 2 * qps = 480",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User get 10GB free space\nAssume user uploads 2 files perday the average file size is 500KB\n1:1 read to write ratio\n50Million * 10GB = 500PB\n10 Million * 2 / 24 / 3600 = 240\npeak qps = 2 * qps = 480",
      "autoResize": true,
      "lineHeight": 1.25
    },
