      "seed": 647763074,
      "version": 444,
      "versionNonce": 412612574,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788175847285,
      "link": null,
      "locked": false,
      "text": "- What kind of chat app shall we design? 1 on 1 or group based?\n- Is this a Mobile App or webApp or Both?\n- what is the scale of this app? --> Back of the envelop estimation\n- for a group chat what is the group number limit? \n- what is the message size limit..?\n- Is End to End Encryption required?\n- How long shall we store the chat history..?\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- What kind of chat app shall we design? 1 on 1 or group based?\n- Is this a Mobile App or webApp or Both?\n- what is the scale of this app? --> Back of the envelop estimation\n- for a group chat what is the group number limit? \n- what is the message size limit..?\n- Is End to End Encryption required?\n- How long shall we store the chat history..?\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
