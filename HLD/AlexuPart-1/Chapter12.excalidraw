      "isDeleted": false,
      "boundElements": [],
      "updated": 1788177061183,
      "link": null,
      "locked": false,
      "text": "- long polling\n    - client hold the connection until there is an message or a timeout threshold has been reached\n    - once it recives the reuqest it will start send the request once again \n    \n    - Load balancing server Instance has message may not be connected to client\n    - No godd way to tell if the client is disconnected\n    - if user doesn't chat much it is in efficient",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- long polling\n    - client hold the connection until there is an message or a timeout threshold has been reached\n    - once it recives the reuqest it will start send the request once again \n    \n    - Load balancing server Instance has message may not be connected to client\n    - No godd way to tell if the client is disconnected\n    - if user doesn't chat much it is in efficient",
      "autoResize": true,
      "lineHeight": 1.25
    },
