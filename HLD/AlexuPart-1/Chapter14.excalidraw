      "seed": 2008308532,
      "version": 314,
      "versionNonce": 582985908,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788434824768,
      "link": null,
      "locked": false,
      "text": "Back of the Envelop Estimation\n    - Assume 5 Million DAUS\n    - Users wathces 5 videos per day\n    - 10 % users uplaod 1 video per day\n    - Assume the average video size is 300MB\n    - 5 Million * 10% * 300 = 150TB\n\n5Million * 5 Videos * 0.3GB * 0.02 = 150,000 perdy CDN Cost",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Back of the Envelop Estimation\n    - Assume 5 Million DAUS\n    - Users wathces 5 videos per day\n    - 10 % users uplaod 1 video per day\n    - Assume the average video size is 300MB\n    - 5 Million * 10% * 300 = 150TB\n\n5Million * 5 Videos * 0.3GB * 0.02 = 150,000 perdy CDN Cost",
      "autoResize": true,
      "lineHeight": 1.25
