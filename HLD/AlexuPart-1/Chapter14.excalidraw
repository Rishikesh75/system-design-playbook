      "text": "Desing Youtube/Design Video Streamming platform\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Desing Youtube/Design Video Streamming platform\n\n",
