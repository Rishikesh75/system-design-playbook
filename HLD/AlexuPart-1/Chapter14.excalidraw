    },
    {
      "id": "Hktqu8wCSmVhG21OPB6Rn",
      "type": "text",
      "x": -211.54789353371234,
      "y": 403.40896509057643,
      "width": 1060.5955810546875,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 270319884,
      "version": 411,
      "versionNonce": 1552271540,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788434649459,
      "link": null,
      "locked": false,
      "text": "- Ability to upload and downlaod Video\n- Smooth viedo Streamming\n- Ability to change the Viedo Quality\n- Low Infra cost\n- High Avalibility scalability and reliability requirements\n- client supported : Mobile Apps ,Web Browser and Smart TV",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Ability to upload and downlaod Video\n- Smooth viedo Streamming\n- Ability to change the Viedo Quality\n- Low Infra cost\n- High Avalibility scalability and reliability requirements\n- client supported : Mobile Apps ,Web Browser and Smart TV",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jVZEiQ6BOSZAPjmqx0gL8",
      "type": "text",
      "x": -108.59370802878766,
      "y": -200.60156741763524,
      "width": 1344.49169921875,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
