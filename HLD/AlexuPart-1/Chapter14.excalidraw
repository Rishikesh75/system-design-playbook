      "seed": 1400422284,
      "version": 547,
      "versionNonce": 1847544972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788434649459,
      "link": null,
      "locked": false,
      "text": "Most Important Feature\n    - Ability to upload and downlaod a video\n Devices Supported \n    -Mobile , Web Browser and Watch a Video\n Daily Active Users\n    -5Million\n  Average Daily Time spent on the product\n    - 30 Min\n Do you need to support internatinal Users\n    -Yes\n Max File size - 1GB\nSupported Video Resolutions - Accept various video resolutions and formats",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Most Important Feature\n    - Ability to upload and downlaod a video\n Devices Supported \n    -Mobile , Web Browser and Watch a Video\n Daily Active Users\n    -5Million\n  Average Daily Time spent on the product\n    - 30 Min\n Do you need to support internatinal Users\n    -Yes\n Max File size - 1GB\nSupported Video Resolutions - Accept various video resolutions and formats",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oWOz-463lGB59xwG1RhA4",
      "type": "text",
      "x": 1612.7320623134403,
      "y": -211.41840872062812,
      "width": 606.5196533203125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
