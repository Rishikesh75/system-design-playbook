      "seed": 1381596468,
      "version": 258,
      "versionNonce": 1639790260,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788437916154,
      "link": null,
      "locked": false,
      "text": "Streamming Protocals\n    - MPEG-DASH --> Moving Pictures Experts Group and Dynamic Adaptive Streamming over Http\n    - Apple HLS --> Http Live streaming\n    - Microsoft smooth streamming\n    - Adobe HTTP Dynamic streamming(HDS)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Streamming Protocals\n    - MPEG-DASH --> Moving Pictures Experts Group and Dynamic Adaptive Streamming over Http\n    - Apple HLS --> Http Live streaming\n    - Microsoft smooth streamming\n    - Adobe HTTP Dynamic streamming(HDS)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i3J5DLQINNjKK0g4cOJjo",
      "type": "text",
      "x": 4316.582653424504,
      "y": 433.28938520955677,
      "width": 850.939453125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
