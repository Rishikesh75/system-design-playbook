      "versionNonce": 606086924,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788438991564,
      "link": null,
      "locked": false,
      "text": "Video Transcoding\n    - Video must be encoded into compatible bitrates and formats\n    - Bitrates -  rate at which bits are processed over time(higer bit rate more quality)\n                    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Video Transcoding\n    - Video must be encoded into compatible bitrates and formats\n    - Bitrates -  rate at which bits are processed over time(higer bit rate more quality)\n                    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
