      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Downloading a video - whole video is downlaoded \nStreamming a Video - Video is recived in streams",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SY994G5wsa1_FY_Rgb6W3",
      "type": "text",
      "x": 2840.8724085846266,
      "y": 1434.3070042044849,
      "width": 951.439453125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
