      "isDeleted": false,
      "boundElements": null,
      "updated": 1790062278146,
      "link": null,
      "locked": false,
      "text": "video is split or further split\ninto small group of pictures(GOP).\nGOP -> group of frames arraged in specfic order",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "video is split or further split\ninto small group of pictures(GOP).\nGOP -> group of frames arraged in specfic order",
      "autoResize": true,
      "lineHeight": 1.25
    },
