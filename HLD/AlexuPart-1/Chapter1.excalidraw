      "isDeleted": false,
      "boundElements": null,
      "updated": 1784478054151,
      "link": null,
      "locked": false,
      "text": "Stateful Architecture: Server remember the client data ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stateful Architecture: Server remember the client data ",
