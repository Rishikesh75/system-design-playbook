      "isDeleted": false,
      "boundElements": [],
      "updated": 1784478052050,
      "link": null,
      "locked": false,
      "text": "Stateless Architecture: Server doesn't remember the client data ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stateless Architecture: Server doesn't remember the client data ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
