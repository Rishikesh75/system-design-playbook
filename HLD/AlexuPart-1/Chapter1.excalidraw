    },
    {
      "id": "Ts-Dr4cbB4f5p7mKw1sC4",
      "type": "text",
      "x": 6156.569759077253,
      "y": 206.80028614363437,
      "width": 1267.19921875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
