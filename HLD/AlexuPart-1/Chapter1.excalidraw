    {
      "id": "5ThUvUXp5hSNjmZprILHn",
      "type": "text",
      "x": 1362.2939504929088,
      "y": 1346.4037753074967,
      "width": 1286.999267578125,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 956411455,
      "version": 540,
      "versionNonce": 281330495,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784475951137,
      "link": null,
      "locked": false,
      "text": "Types of Databases:\n    1.Relational Databases/SQL Databases : MySql,Postgress\n        \n    2.NonRelational Databases/NoSql Databases: DynamoDb,Cassandra\n        1.Key Value Storage\n        2.Graph Storage\n        3.Column Storage\n        4.Document Storage \n        \n        Advantages of Using NoSql:\n            1.Super Low Latency\n            2.Data is UnStructured\n            3.Serilize and Deserilize the data\n            4.You need to store massive amount of data",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Types of Databases:\n    1.Relational Databases/SQL Databases : MySql,Postgress\n        \n    2.NonRelational Databases/NoSql Databases: DynamoDb,Cassandra\n        1.Key Value Storage\n        2.Graph Storage\n        3.Column Storage\n        4.Document Storage \n        \n        Advantages of Using NoSql:\n            1.Super Low Latency\n            2.Data is UnStructured\n            3.Serilize and Deserilize the data\n            4.You need to store massive amount of data",
      "autoResize": true,
      "lineHeight": 1.25
    },
